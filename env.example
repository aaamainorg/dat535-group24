# =============================================================================
# Credentials and settings for the DAT535 Group 24 pipeline - TEMPLATE
#
# Copy this file to ".env" (same folder) and fill in your own values:
#     cp env.example .env
# ".env" is listed in .gitignore, so it is never pushed to GitHub.
# GitHub Actions does not read .env - add the same values as repository
# secrets there (Settings -> Secrets and variables -> Actions).
# =============================================================================

# MET Norway Frost API - free, create a user at https://frost.met.no/auth/requestCredentials.html
# The client ID is used as the user name (empty password) for open data.
FROST_CLIENT_ID=your-frost-client-id

# The client secret is only needed for OAuth2 / restricted data.
# Our pipeline does not send it, but keep it here so the group has it in one place.
FROST_CLIENT_SECRET=your-frost-client-secret

# -----------------------------------------------------------------------------
# Period: which months of Frost temperature data to fetch (format YYYY-MM).
# The pipeline reads the two lines for the environment it runs in
# (NORGESPRIS_ENV=dev or prod). An empty END month = up to the last complete month.
# -----------------------------------------------------------------------------
NORGESPRIS_DEV_START_MONTH=2025-09
NORGESPRIS_DEV_END_MONTH=2025-10
NORGESPRIS_PROD_START_MONTH=2023-11
NORGESPRIS_PROD_END_MONTH=

# -----------------------------------------------------------------------------
# Landing folder: where the raw downloaded files are stored (unchanged), before
# they are loaded into the bronze schema in PostgreSQL. A sub folder dev/ or
# prod/ is added. Manual files go in <landing>/<env>/_manual/<source>/<dataset>/.
# /tmp is cleaned by the system - then the next run downloads again.
# -----------------------------------------------------------------------------
NORGESPRIS_LANDING_ROOT=/tmp/norgespris-landing

# -----------------------------------------------------------------------------
# PostgreSQL target (created with scripts/init_postgres.sql - see README).
# The database name is norgespris_dev or norgespris_prod, chosen by NORGESPRIS_ENV;
# set NORGESPRIS_PG_DATABASE only if you want to override that.
# -----------------------------------------------------------------------------
NORGESPRIS_PG_HOST=localhost
NORGESPRIS_PG_PORT=5432
NORGESPRIS_PG_USER=norgespris
NORGESPRIS_PG_PASSWORD=your-postgres-password
# NORGESPRIS_PG_DATABASE=
# Only if Spark cannot download the JDBC driver from Maven Central (offline / blocked):
# NORGESPRIS_PG_JDBC_JAR=/path/to/postgresql-42.7.4.jar
